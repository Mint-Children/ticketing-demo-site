function loadLocalStorage(key, fallback) {
  try {
    const saved = localStorage.getItem(key);
    return saved ? JSON.parse(saved) : fallback;
  } catch {
    return fallback;
  }
}

function saveLocalStorage(key, value) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
  } catch {
    // Frontend-only demo: storage failures should not blank the app.
  }
}

function removeLocalStorage(key) {
  try {
    localStorage.removeItem(key);
  } catch {
    // Ignore storage cleanup failures in the demo shell.
  }
}

function safeArray(value) {
  return Array.isArray(value) ? value : [];
}

function safeObjectOrNull(value) {
  return value && typeof value === 'object' && !Array.isArray(value) ? value : null;
}

function safeBoolean(value) {
  return typeof value === 'boolean' ? value : false;
}

function safeString(value, fallback = '') {
  return typeof value === 'string' ? value : fallback;
}

function safeNumber(value, fallback = 0) {
  const number = Number(value);
  return Number.isFinite(number) ? number : fallback;
}

function normalizeRiskLevel(value) {
  return ['high', 'medium', 'low'].includes(value) ? value : 'low';
}

function normalizeTrafficLevel(value) {
  return ['혼잡', '보통', '여유'].includes(value) ? value : '여유';
}

function normalizeTicketOpenStatus(value) {
  return ['예매중', '오픈예정', '매진임박', '일반예매'].includes(value) ? value : '일반예매';
}

function getRiskLabel(level) {
  const labels = { high: '높음', medium: '보통', low: '낮음' };
  return labels[normalizeRiskLevel(level)];
}

function getRiskClass(level) {
  return `risk-${normalizeRiskLevel(level)}`;
}

function getSecurityBadgeLabel(event) {
  return event?.captchaRequired ? 'AI CAPTCHA 적용' : '빠른 예매';
}

function getSecurityDecisionLabel(reservation) {
  if (reservation?.demoRiskMode === 'bot') return '추가 인증 완료';
  if (reservation?.captchaRequired) return reservation.captchaVerified ? 'AI CAPTCHA 인증 완료' : 'AI CAPTCHA 인증 필요';
  return '일반 예매';
}

function loadSafeStorage(key, fallback, sanitize) {
  const loaded = loadLocalStorage(key, fallback);
  const safeValue = sanitize(loaded);
  if (JSON.stringify(loaded) !== JSON.stringify(safeValue)) {
    saveLocalStorage(key, safeValue);
  }
  return safeValue;
}

function sanitizeStoredUser(value) {
  const user = safeObjectOrNull(value);
  if (!user) return null;

  const id = safeString(user.id).trim();
  const password = safeString(user.password);
  const name = safeString(user.name).trim();
  if (!id || !password || !name) return null;

  return {
    id,
    password,
    name,
    email: safeString(user.email),
    phone: safeString(user.phone)
  };
}

function sanitizeUsers(value) {
  return safeArray(value).map(sanitizeStoredUser).filter(Boolean);
}

function sanitizeCurrentUser(value) {
  const user = safeObjectOrNull(value);
  if (!user) return null;

  const id = safeString(user.id).trim();
  const name = safeString(user.name).trim();
  if (!id || !name) return null;

  return {
    id,
    name,
    email: safeString(user.email),
    phone: safeString(user.phone)
  };
}

function sanitizeBookingItem(value) {
  const item = safeObjectOrNull(value);
  if (!item) return null;

  const title = safeString(item.title).trim();
  const quantity = Math.max(0, Math.trunc(safeNumber(item.quantity)));
  const totalPrice = Math.max(0, safeNumber(item.totalPrice));
  if (!title || quantity <= 0 || totalPrice <= 0) return null;

  return {
    id: safeString(item.id, `item-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`),
    eventId: safeString(item.eventId),
    title,
    category: safeString(item.category),
    dateLabel: safeString(item.dateLabel, '일정 미정'),
    time: safeString(item.time, '회차 미정'),
    venue: safeString(item.venue, '장소 미정'),
    region: safeString(item.region),
    seatSummary: safeString(item.seatSummary, `총 ${quantity}매`),
    quantity,
    totalPrice,
    captchaRequired: safeBoolean(item.captchaRequired),
    riskLevel: normalizeRiskLevel(item.riskLevel),
    riskReason: safeString(item.riskReason),
    queueRequired: safeBoolean(item.queueRequired),
    trafficLevel: normalizeTrafficLevel(item.trafficLevel),
    ticketOpenStatus: normalizeTicketOpenStatus(item.ticketOpenStatus)
  };
}

function sanitizeCartItems(value) {
  return safeArray(value).map(sanitizeBookingItem).filter(Boolean);
}

function sanitizeReservation(value) {
  const reservation = safeObjectOrNull(value);
  if (!reservation) return null;

  const id = safeString(reservation.id).trim();
  const title = safeString(reservation.title).trim();
  const quantity = Math.max(0, Math.trunc(safeNumber(reservation.quantity)));
  const totalPrice = Math.max(0, safeNumber(reservation.totalPrice));
  if (!id || !title || quantity <= 0 || totalPrice <= 0) return null;

  return {
    id,
    eventId: safeString(reservation.eventId),
    title,
    date: safeString(reservation.date, '일정 미정'),
    time: safeString(reservation.time, '회차 미정'),
    venue: safeString(reservation.venue, '장소 미정'),
    region: safeString(reservation.region),
    seatSummary: safeString(reservation.seatSummary, `총 ${quantity}매`),
    quantity,
    totalPrice,
    status: safeString(reservation.status, '예매 신청 완료'),
    captchaVerified: reservation.captchaVerified === false ? false : true,
    captchaRequired: safeBoolean(reservation.captchaRequired),
    captchaSkippedReason: safeString(reservation.captchaSkippedReason) || null,
    riskLevel: normalizeRiskLevel(reservation.riskLevel),
    riskReason: safeString(reservation.riskReason),
    demoRiskMode: reservation.demoRiskMode === 'bot' ? 'bot' : 'normal',
    queueUsed: safeBoolean(reservation.queueUsed),
    trafficLevel: normalizeTrafficLevel(reservation.trafficLevel),
    securityDecision: safeString(reservation.securityDecision, reservation.captchaRequired ? 'AI CAPTCHA 인증 완료' : '일반 예매 - CAPTCHA 미적용'),
    createdAt: safeString(reservation.createdAt)
  };
}

function sanitizeReservations(value) {
  return safeArray(value).map(sanitizeReservation).filter(Boolean);
}

function sanitizeBooking(value) {
  const booking = safeObjectOrNull(value);
  if (!booking) return null;
  const items = sanitizeCartItems(booking.items);
  if (items.length === 0) return null;
  return {
    source: booking.source === 'cart' ? 'cart' : 'booking',
    items,
    demoRiskMode: booking.demoRiskMode === 'bot' ? 'bot' : 'normal',
    queueUsed: safeBoolean(booking.queueUsed)
  };
}

function formatWon(value) {
  return `${safeNumber(value).toLocaleString('ko-KR')}원`;
}

function getEventById(eventId) {
  return mockEvents.find((event) => event.id === eventId) || mockEvents[0];
}

function getHighestRiskLevel(items, demoRiskMode = 'normal') {
  if (demoRiskMode === 'bot') return 'high';
  if (items.some((item) => item.riskLevel === 'high')) return 'high';
  if (items.some((item) => item.riskLevel === 'medium')) return 'medium';
  return 'low';
}

function getHighestTrafficLevel(items) {
  if (items.some((item) => item.trafficLevel === '혼잡')) return '혼잡';
  if (items.some((item) => item.trafficLevel === '보통')) return '보통';
  return '여유';
}

function getBookingSecurityProfile(booking, demoRiskMode = 'normal', queueUsed = false, captchaVerified = false) {
  const safeBooking = sanitizeBooking(booking);
  const items = safeBooking?.items || [];
  const enrichedItems = items.map((item) => {
    const event = getEventById(item.eventId);
    return {
      ...item,
      captchaRequired: Boolean(event.captchaRequired) || item.captchaRequired,
      riskLevel: event.riskLevel || item.riskLevel,
      riskReason: event.riskReason || item.riskReason,
      queueRequired: Boolean(event.queueRequired) || item.queueRequired,
      trafficLevel: event.trafficLevel || item.trafficLevel,
      ticketOpenStatus: event.ticketOpenStatus || item.ticketOpenStatus
    };
  });

  const botScenario = demoRiskMode === 'bot';
  const captchaRequired = botScenario || enrichedItems.some((item) => item.captchaRequired);
  const highRiskItem = enrichedItems.find((item) => item.captchaRequired || item.riskLevel === 'high');
  const riskLevel = getHighestRiskLevel(enrichedItems, demoRiskMode);
  const trafficLevel = getHighestTrafficLevel(enrichedItems);
  const riskReason = botScenario
    ? '비정상 예매 패턴이 감지되어 추가 인증이 필요함'
    : highRiskItem?.riskReason || enrichedItems[0]?.riskReason || '저위험 일반 예매';
  const securityDecision = botScenario
    ? '봇 의심 패턴 감지 - 추가 인증 완료'
    : captchaRequired
      ? (captchaVerified ? 'AI CAPTCHA 인증 완료' : 'AI CAPTCHA 인증 필요')
      : '일반 예매 - CAPTCHA 미적용';

  return {
    captchaRequired,
    captchaVerified: captchaRequired ? Boolean(captchaVerified) : false,
    captchaSkippedReason: captchaRequired ? null : '저위험 일반 예매',
    riskLevel,
    riskReason,
    demoRiskMode: botScenario ? 'bot' : 'normal',
    queueUsed: Boolean(queueUsed),
    trafficLevel,
    securityDecision
  };
}

function getEmptyQuantities(event) {
  return event.seatOptions.reduce((acc, seat) => ({ ...acc, [seat.id]: 0 }), {});
}

function sanitizeSeatQuantities(value, event) {
  const quantities = safeObjectOrNull(value) || {};
  return event.seatOptions.reduce((acc, seat) => ({
    ...acc,
    [seat.id]: Math.max(0, Math.trunc(safeNumber(quantities[seat.id])))
  }), {});
}

function getTotalPrice(event, quantities) {
  const safeQuantities = sanitizeSeatQuantities(quantities, event);
  return event.seatOptions.reduce((sum, seat) => sum + seat.price * safeQuantities[seat.id], 0);
}

function getTotalQuantity(event, quantities) {
  return Object.values(sanitizeSeatQuantities(quantities, event)).reduce((sum, quantity) => sum + quantity, 0);
}

function getSeatSummary(event, quantities) {
  const safeQuantities = sanitizeSeatQuantities(quantities, event);
  return event.seatOptions
    .filter((seat) => safeQuantities[seat.id] > 0)
    .map((seat) => `${seat.name} ${safeQuantities[seat.id]}매`)
    .join(', ');
}

function createReservation(booking, securityProfile = {}) {
  const safeBooking = sanitizeBooking(booking);
  if (!safeBooking) return null;

  const now = Date.now();
  const firstItem = safeBooking.items[0];
  const title = safeBooking.items.length > 1 ? `${firstItem.title} 외 ${safeBooking.items.length - 1}건` : firstItem.title;

  return {
    id: `TON-${String(now).slice(-8)}`,
    eventId: firstItem.eventId,
    title,
    date: firstItem.dateLabel,
    time: firstItem.time,
    venue: firstItem.venue,
    region: firstItem.region,
    seatSummary: safeBooking.items.map((item) => item.seatSummary).join(' / '),
    quantity: safeBooking.items.reduce((sum, item) => sum + item.quantity, 0),
    totalPrice: safeBooking.items.reduce((sum, item) => sum + item.totalPrice, 0),
    status: '예매 신청 완료',
    captchaRequired: safeBoolean(securityProfile.captchaRequired),
    captchaVerified: safeBoolean(securityProfile.captchaVerified),
    captchaSkippedReason: securityProfile.captchaSkippedReason || null,
    riskLevel: normalizeRiskLevel(securityProfile.riskLevel),
    riskReason: safeString(securityProfile.riskReason),
    demoRiskMode: securityProfile.demoRiskMode === 'bot' ? 'bot' : 'normal',
    queueUsed: safeBoolean(securityProfile.queueUsed),
    trafficLevel: normalizeTrafficLevel(securityProfile.trafficLevel),
    securityDecision: safeString(securityProfile.securityDecision, securityProfile.captchaRequired ? 'AI CAPTCHA 인증 완료' : '일반 예매 - CAPTCHA 미적용'),
    createdAt: new Date(now).toLocaleDateString('ko-KR')
  };
}

function eventMatchesSearch(event, query) {
  const normalized = query.trim().toLowerCase();
  if (!normalized) return true;
  return [
    event.title,
    event.category,
    event.venue,
    event.region,
    event.description,
    event.shortDescription,
    event.detailDescription
  ].some((field) => field.toLowerCase().includes(normalized));
}

export default function App() {
  const [page, setPage] = useState('home');
  const [users, setUsers] = useState(() => loadSafeStorage(STORAGE_KEYS.users, [], sanitizeUsers));
  const [currentUser, setCurrentUser] = useState(() => {
    const autoLogin = loadSafeStorage(STORAGE_KEYS.autoLogin, false, safeBoolean);
    return autoLogin ? loadSafeStorage(STORAGE_KEYS.currentUser, null, sanitizeCurrentUser) : null;
  });
  const [reservations, setReservations] = useState(() => loadSafeStorage(STORAGE_KEYS.reservations, [], sanitizeReservations));
  const [cartItems, setCartItems] = useState(() => loadSafeStorage(STORAGE_KEYS.cart, [], sanitizeCartItems));
  const [selectedEvent, setSelectedEvent] = useState(mockEvents[0]);
  const [selectedDateId, setSelectedDateId] = useState(mockEvents[0].availableDates[0].id);
  const [selectedTime, setSelectedTime] = useState(mockEvents[0].availableTimes[0]);
  const [seatQuantities, setSeatQuantities] = useState(() => getEmptyQuantities(mockEvents[0]));
  const [searchQuery, setSearchQuery] = useState('');
  const [submittedSearch, setSubmittedSearch] = useState('');
  const [activeCategory, setActiveCategory] = useState('');
  const [selectedRegion, setSelectedRegion] = useState('전체');
  const [selectedQuickDate, setSelectedQuickDate] = useState(quickDates[0]);
  const [drawerOpen, setDrawerOpen] = useState(false);
  const [likedShows, setLikedShows] = useState([]);
  const [toast, setToast] = useState('');
  const [demoRiskMode, setDemoRiskMode] = useState('normal');
  const [queueOpen, setQueueOpen] = useState(false);
  const [captchaOpen, setCaptchaOpen] = useState(false);
  const [successReservation, setSuccessReservation] = useState(null);
  const [pendingBooking, setPendingBooking] = useState(null);
  const [loginForm, setLoginForm] = useState({ id: '', password: '', autoLogin: false });
  const [loginError, setLoginError] = useState('');
  const [loginNotice, setLoginNotice] = useState('');
  const [signupForm, setSignupForm] = useState({
    name: '',
    id: '',
    email: '',
    password: '',
    confirmPassword: '',
    phone: '',
    terms: false
  });
  const [signupMessage, setSignupMessage] = useState('');
  const [signupError, setSignupError] = useState('');

  const validCartItems = useMemo(() => sanitizeCartItems(cartItems), [cartItems]);
  const validReservations = useMemo(() => sanitizeReservations(reservations), [reservations]);
  const activeEvent = selectedEvent || mockEvents[0];
  const safeQuantities = useMemo(() => sanitizeSeatQuantities(seatQuantities, activeEvent), [activeEvent, seatQuantities]);
  const totalPrice = useMemo(() => getTotalPrice(activeEvent, safeQuantities), [activeEvent, safeQuantities]);
  const totalQuantity = useMemo(() => getTotalQuantity(activeEvent, safeQuantities), [activeEvent, safeQuantities]);
  const cartTotalPrice = validCartItems.reduce((sum, item) => sum + item.totalPrice, 0);
  const allUsers = [DEFAULT_USER, ...users];

  const rankedEvents = useMemo(() => [...mockEvents].sort((a, b) => a.rank - b.rank), []);
  const searchResults = useMemo(() => mockEvents.filter((event) => eventMatchesSearch(event, submittedSearch)), [submittedSearch]);
  const categoryEvents = useMemo(
    () => mockEvents.filter((event) => event.category === activeCategory),
    [activeCategory]
  );
  const regionEvents = useMemo(
    () => selectedRegion === '전체' ? mockEvents : mockEvents.filter((event) => event.region === selectedRegion),
    [selectedRegion]
  );
  const quickDateEvents = useMemo(
    () => mockEvents.filter((event) => event.availableDates.some((date) => date.quickDate === selectedQuickDate.id)),
    [selectedQuickDate]
  );

  const showToast = (message) => {
    setToast(message);
    window.setTimeout(() => setToast(''), 2400);
  };

  const navigate = (nextPage) => {
    setPage(nextPage);
    setDrawerOpen(false);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const openEventDetail = (event) => {
    setSelectedEvent(event);
    setSelectedDateId(event.availableDates[0]?.id || '');
    setSelectedTime(event.availableTimes[0] || '');
    setSeatQuantities(getEmptyQuantities(event));
    navigate('eventDetail');
  };

  const openCategory = (category) => {
    setActiveCategory(category);
    navigate('category');
  };

  const openQuickDate = (date) => {
    setSelectedQuickDate(date);
    navigate('date');
  };

  const handleCategoryNav = (item) => {
    if (item === '랭킹') {
      navigate('ranking');
      return;
    }
    if (item === '이벤트·혜택') {
      navigate('benefits');
      return;
    }
    if (item === '지역별') {
      navigate('regions');
      return;
    }
    openCategory(item);
  };

  const handleSearchSubmit = (event) => {
    event.preventDefault();
    setSubmittedSearch(searchQuery.trim());
    navigate('search');
  };

  const updateQuantity = (seatId, direction) => {
    setSeatQuantities((prev) => {
      const current = sanitizeSeatQuantities(prev, activeEvent);
      return {
        ...current,
        [seatId]: Math.max(0, current[seatId] + direction)
      };
    });
  };

  const buildBookingFromEvent = (event) => {
    const eventQuantities = sanitizeSeatQuantities(seatQuantities, event);
    const selectedDate = event.availableDates.find((date) => date.id === selectedDateId) || event.availableDates[0];
    const quantity = getTotalQuantity(event, eventQuantities);
    return {
      source: 'booking',
      items: [
        {
          id: `item-${Date.now()}`,
          eventId: event.id,
          title: event.title,
          category: event.category,
          dateLabel: selectedDate?.label || event.dateRange,
          time: selectedTime || event.availableTimes[0] || '회차 미정',
          venue: event.venue,
          region: event.region,
          seatSummary: getSeatSummary(event, eventQuantities),
          quantity,
          totalPrice: getTotalPrice(event, eventQuantities),
          captchaRequired: Boolean(event.captchaRequired),
          riskLevel: event.riskLevel,
          riskReason: event.riskReason,
          queueRequired: Boolean(event.queueRequired),
          trafficLevel: event.trafficLevel,
          ticketOpenStatus: event.ticketOpenStatus
        }
      ],
      demoRiskMode
    };
  };

  const requiresQueue = (booking) => {
    const safeBooking = sanitizeBooking(booking);
    return Boolean(safeBooking?.items.some((item) => item.queueRequired || getEventById(item.eventId).queueRequired));
  };

  const shouldRequireCaptcha = (booking) => getBookingSecurityProfile(booking, demoRiskMode).captchaRequired;

  const completeReservationFlow = (booking, { captchaVerified = false, queueUsed = false } = {}) => {
    const safeBooking = sanitizeBooking(booking);
    if (!safeBooking) {
      setQueueOpen(false);
      setCaptchaOpen(false);
      setPendingBooking(null);
      showToast('예매 정보를 다시 선택해 주세요.');
      return;
    }

    const securityProfile = getBookingSecurityProfile(safeBooking, demoRiskMode, queueUsed, captchaVerified);
    const reservation = createReservation({ ...safeBooking, demoRiskMode, queueUsed }, securityProfile);
    if (!reservation) {
      setQueueOpen(false);
      setCaptchaOpen(false);
      setPendingBooking(null);
      showToast('예매 정보를 다시 선택해 주세요.');
      return;
    }

    const nextReservations = [reservation, ...validReservations];
    setReservations(nextReservations);
    saveLocalStorage(STORAGE_KEYS.reservations, nextReservations);

    if (safeBooking.source === 'cart') {
      setCartItems([]);
      saveLocalStorage(STORAGE_KEYS.cart, []);
    }

    setSeatQuantities(getEmptyQuantities(activeEvent));
    setQueueOpen(false);
    setCaptchaOpen(false);
    setSuccessReservation(reservation);
    setPendingBooking(null);
  };

  const startBookingFlow = (booking) => {
    const safeBooking = sanitizeBooking(booking);
    if (!safeBooking) {
      showToast('예매 정보를 다시 선택해 주세요.');
      return;
    }

    const preparedBooking = { ...safeBooking, demoRiskMode, queueUsed: false };
    setPendingBooking(preparedBooking);

    if (requiresQueue(preparedBooking)) {
      setQueueOpen(true);
      return;
    }

    if (shouldRequireCaptcha(preparedBooking)) {
      setCaptchaOpen(true);
      return;
    }

    completeReservationFlow(preparedBooking, { captchaVerified: false, queueUsed: false });
  };

  const handleReserveClick = (event) => {
    const quantity = getTotalQuantity(event, safeQuantities);
    if (quantity === 0) {
      showToast('좌석 수량을 먼저 선택해 주세요.');
      return;
    }
    startBookingFlow(buildBookingFromEvent(event));
  };

  const addEventToCart = (event) => {
    const quantity = getTotalQuantity(event, safeQuantities);
    if (quantity === 0) {
      showToast('좌석 수량을 먼저 선택해 주세요.');
      return;
    }

    const item = buildBookingFromEvent(event).items[0];
    const nextCart = [...validCartItems, item];
    setCartItems(nextCart);
    saveLocalStorage(STORAGE_KEYS.cart, nextCart);
    showToast('장바구니에 담았습니다.');
  };

  const proceedCartBooking = () => {
    if (validCartItems.length === 0) {
      showToast('장바구니에 담긴 공연이 없습니다.');
      return;
    }

    startBookingFlow({ source: 'cart', items: validCartItems, demoRiskMode });
  };

  const completeCaptcha = () => {
    const safeBooking = sanitizeBooking(pendingBooking);
    if (!safeBooking) {
      setCaptchaOpen(false);
      setPendingBooking(null);
      showToast('예매 정보를 다시 선택해 주세요.');
      return;
    }

    completeReservationFlow(safeBooking, { captchaVerified: true, queueUsed: pendingBooking?.queueUsed });
  };

  const enterQueue = () => {
    const safeBooking = sanitizeBooking(pendingBooking);
    if (!safeBooking) {
      setQueueOpen(false);
      setPendingBooking(null);
      showToast('예매 정보를 다시 선택해 주세요.');
      return;
    }

    const queuedBooking = { ...safeBooking, demoRiskMode, queueUsed: true };
    setPendingBooking(queuedBooking);
    setQueueOpen(false);

    if (shouldRequireCaptcha(queuedBooking)) {
      setCaptchaOpen(true);
      return;
    }

    completeReservationFlow(queuedBooking, { captchaVerified: false, queueUsed: true });
  };

  const cancelQueue = () => {
    setQueueOpen(false);
    setPendingBooking(null);
  };

  const removeCartItem = (itemId) => {
    const nextCart = validCartItems.filter((item) => item.id !== itemId);
    setCartItems(nextCart);
    saveLocalStorage(STORAGE_KEYS.cart, nextCart);
  };

  const handleLogin = (event) => {
    event.preventDefault();
    setLoginError('');

    const found = allUsers.find((user) => user.id === loginForm.id && user.password === loginForm.password);
    if (!found) {
      setLoginError('아이디 또는 비밀번호를 확인해 주세요.');
      return;
    }

    const safeUser = {
      id: found.id,
      name: found.name,
      email: found.email,
      phone: found.phone
    };
    setCurrentUser(safeUser);

    if (loginForm.autoLogin) {
      saveLocalStorage(STORAGE_KEYS.autoLogin, true);
      saveLocalStorage(STORAGE_KEYS.currentUser, safeUser);
    } else {
      saveLocalStorage(STORAGE_KEYS.autoLogin, false);
      removeLocalStorage(STORAGE_KEYS.currentUser);
    }

    setLoginNotice('');
    navigate('home');
  };

  const handleLogout = () => {
    setCurrentUser(null);
    saveLocalStorage(STORAGE_KEYS.autoLogin, false);
    removeLocalStorage(STORAGE_KEYS.currentUser);
    navigate('home');
  };

  const handleSignup = (event) => {
    event.preventDefault();
    setSignupError('');
    setSignupMessage('');

    if (!signupForm.name || !signupForm.id || !signupForm.email || !signupForm.password || !signupForm.phone) {
      setSignupError('필수 정보를 모두 입력해 주세요.');
      return;
    }
    if (signupForm.password !== signupForm.confirmPassword) {
      setSignupError('비밀번호 확인이 일치하지 않습니다.');
      return;
    }
    if (!signupForm.terms) {
      setSignupError('약관 동의가 필요합니다.');
      return;
    }
    if (allUsers.some((user) => user.id === signupForm.id)) {
      setSignupError('이미 사용 중인 아이디입니다.');
      return;
    }

    const newUser = {
      id: signupForm.id,
      password: signupForm.password,
      name: signupForm.name,
      email: signupForm.email,
      phone: signupForm.phone
    };
    const nextUsers = [...users, newUser];
    setUsers(nextUsers);
    saveLocalStorage(STORAGE_KEYS.users, nextUsers);
    setSignupMessage('회원가입이 완료되었습니다. 로그인해 주세요.');
    setLoginNotice('회원가입이 완료되었습니다. 새 계정으로 로그인해 주세요.');
    setSignupForm({
      name: '',
      id: '',
      email: '',
      password: '',
      confirmPassword: '',
      phone: '',
      terms: false
    });
    window.setTimeout(() => navigate('login'), 650);
  };

  const toggleLike = (title) => {
    setLikedShows((prev) => (prev.includes(title) ? prev.filter((item) => item !== title) : [...prev, title]));
  };

  const getHeaderCategoryClass = (item) => {
    if (item === activeCategory && page === 'category') return 'active';
    if (item === '랭킹' && page === 'ranking') return 'active';
    if (item === '이벤트·혜택' && page === 'benefits') return 'active';
    if (item === '지역별' && page === 'regions') return 'active';
    return '';
  };

  const renderSecurityBadges = (event, compact = false) => (
    <div className={`event-security-badges${compact ? ' compact' : ''}`}>
      <span className={`security-pill ${event.captchaRequired ? 'captcha' : 'normal'}`}>
        {getSecurityBadgeLabel(event)}
      </span>
      <span className={`security-pill ${getRiskClass(event.riskLevel)}`}>
        위험도 {getRiskLabel(event.riskLevel)}
      </span>
      <span className={`security-pill traffic-${event.trafficLevel}`}>
        {event.trafficLevel}
      </span>
    </div>
  );

  const renderDemoRiskToggle = () => (
    <div className="demo-risk-toggle" aria-label="데모 시나리오 선택">
      <span>데모 시나리오</span>
      <div>
        <button
          type="button"
          className={demoRiskMode === 'normal' ? 'active' : ''}
          onClick={() => setDemoRiskMode('normal')}
        >
          일반 사용자
        </button>
        <button
          type="button"
          className={demoRiskMode === 'bot' ? 'active warning' : ''}
          onClick={() => setDemoRiskMode('bot')}
        >
          봇 의심 사용자
        </button>
      </div>
      {demoRiskMode === 'bot' && <p>비정상 예매 패턴이 감지되어 추가 인증이 필요합니다.</p>}
    </div>
  );

  const renderSecurityPolicyCard = (event) => (
    <article className={`event-security-note ${event.captchaRequired ? 'protected' : 'standard'}`}>
      <div>
        <span className="page-kicker">SECURITY POLICY</span>
        <h2>{event.captchaRequired ? 'AI CAPTCHA 보호 적용 공연' : '일반 예매 공연'}</h2>
        <p>
          {event.captchaRequired
            ? '본 공연은 예매 경쟁이 높아 자동화 예매 방지를 위한 인증이 진행됩니다.'
            : '현재 공연은 별도 CAPTCHA 인증 없이 빠르게 예매할 수 있습니다.'}
        </p>
      </div>
      <dl>
        <div><dt>위험도</dt><dd>{getRiskLabel(event.riskLevel)}</dd></div>
        <div><dt>트래픽</dt><dd>{event.trafficLevel}</dd></div>
        <div><dt>예매 상태</dt><dd>{event.ticketOpenStatus}</dd></div>
        <div><dt>적용 사유</dt><dd>{event.riskReason}</dd></div>
      </dl>
      {demoRiskMode === 'bot' && (
        <div className="bot-warning-note">봇 의심 사용자 mock 모드에서는 모든 공연에 추가 AI CAPTCHA 인증이 적용됩니다.</div>
      )}
    </article>
  );

  const renderHeader = () => (
    <header className="site-header">
      <div className="header-main">
        <button className="brand" type="button" onClick={() => navigate('home')} aria-label="티켓온 홈으로 이동">
          <span>티켓온</span>
          <small>TICKETON</small>
        </button>
        <form className="search-bar" onSubmit={handleSearchSubmit} role="search">
          <button type="submit" aria-label="검색">⌕</button>
          <label className="sr-only" htmlFor="ticketon-search">공연 검색</label>
          <input
            id="ticketon-search"
            value={searchQuery}
            onChange={(event) => setSearchQuery(event.target.value)}
            placeholder="공연, 아티스트, 장소를 검색해 보세요"
          />
        </form>
        <nav className="top-actions" aria-label="상단 메뉴">
          {currentUser ? (
            <>
              <button type="button" onClick={() => navigate('mypage')}>{currentUser.name}님</button>
              <button type="button" onClick={handleLogout}>로그아웃</button>
            </>
          ) : (
            <>
              <button className={page === 'login' ? 'active' : ''} type="button" onClick={() => navigate('login')}>로그인</button>
              <button className={page === 'signup' ? 'active' : ''} type="button" onClick={() => navigate('signup')}>회원가입</button>
            </>
          )}
          <button className={page === 'mypage' ? 'active' : ''} type="button" onClick={() => navigate('mypage')}>마이페이지</button>
          <button className={page === 'reservations' ? 'active' : ''} type="button" onClick={() => navigate('reservations')}>예매확인</button>
          <button className={`cart-link${page === 'cart' ? ' active' : ''}`} type="button" onClick={() => navigate('cart')}>
            장바구니
            <span>{validCartItems.length}</span>
          </button>
        </nav>
      </div>
      <nav className="category-nav" aria-label="카테고리">
        <button
          className={drawerOpen ? 'active' : ''}
          type="button"
          aria-label="전체 메뉴 열기"
          aria-expanded={drawerOpen}
          onClick={() => setDrawerOpen(true)}
        >
          ☰
        </button>
        {categoryButtons.map((category) => (
          <button
            key={category}
            className={getHeaderCategoryClass(category)}
            type="button"
            onClick={() => handleCategoryNav(category)}
          >
            {category}
          </button>
        ))}
      </nav>
    </header>
  );

  const renderDrawer = () => drawerOpen && (
    <div className="drawer-backdrop" role="presentation" onMouseDown={() => setDrawerOpen(false)}>
      <aside
        className="menu-drawer"
        aria-label="전체 메뉴"
        onMouseDown={(event) => event.stopPropagation()}
      >
        <div className="drawer-head">
          <div>
            <span className="page-kicker">TICKETON MENU</span>
            <h2>전체 카테고리</h2>
          </div>
          <button type="button" onClick={() => setDrawerOpen(false)} aria-label="메뉴 닫기">×</button>
        </div>
        <div className="drawer-links">
          <button type="button" onClick={() => navigate('home')}>전체 카테고리</button>
          {categoryButtons.map((item) => (
            <button key={item} type="button" onClick={() => handleCategoryNav(item)}>{item}</button>
          ))}
          <button type="button" onClick={() => showToast('고객센터는 데모에서 UI만 제공됩니다.')}>고객센터</button>
          <button type="button" onClick={() => showToast('예매 가이드는 데모에서 UI만 제공됩니다.')}>예매 가이드</button>
        </div>
      </aside>
    </div>
  );

  const renderEventCard = (event, compact = false) => (
    <article className={`show-card event-card${compact ? ' compact' : ''}`} key={event.id}>
      <button type="button" onClick={() => openEventDetail(event)} aria-label={`${event.title} 상세 보기`}>
        <div className={`show-poster ${event.posterTone}`}>
          <span>{event.badge}</span>
          <b>{event.title}</b>
        </div>
        <div className="show-info">
          <span>{event.category}</span>
          <h3>{event.title}</h3>
          {renderSecurityBadges(event, true)}
          <p>{event.dateRange}</p>
          <p>{event.venue} · {event.region}</p>
          <small>{event.shortDescription}</small>
        </div>
      </button>
      <button className="like-chip" type="button" onClick={() => toggleLike(event.title)}>
        {likedShows.includes(event.title) ? '♥' : '♡'} {event.likes.toLocaleString('ko-KR')}
      </button>
    </article>
  );

  const renderEventGrid = (events, emptyText = '표시할 공연이 없습니다.') => (
    events.length ? (
      <div className="show-grid">{events.map((event) => renderEventCard(event))}</div>
    ) : (
      <section className="empty-state">
        <h1>{emptyText}</h1>
        <button className="primary-btn" type="button" onClick={() => navigate('home')}>전체 공연 보기</button>
      </section>
    )
  );

  const renderHome = () => {
    const featured = rankedEvents.slice(0, 3);

    return (
      <main className="page-shell">
        <section className="platform-hero">
          <div className="platform-copy">
            <span className="sale-badge">TICKETON PICK</span>
            <h1>오늘 열리는 공연을 한눈에</h1>
            <p>콘서트부터 전시, 스포츠까지 티켓온에서 빠르게 예매하세요.</p>
            <div className="hero-actions">
              <button className="primary-btn" type="button" onClick={() => navigate('ranking')}>인기 공연 보기</button>
              <button className="light-btn" type="button" onClick={() => openQuickDate(quickDates[0])}>오늘 예매 가능 공연</button>
            </div>
          </div>
          <div className="featured-mini-grid">
            {featured.map((event) => (
              <button key={event.id} type="button" onClick={() => openEventDetail(event)}>
                <span>{event.badge}</span>
                <b>{event.title}</b>
                <em>{event.captchaRequired ? '보안 예매' : '빠른 예매'}</em>
                <small>{event.venue}</small>
              </button>
            ))}
          </div>
        </section>

        <section className="content-section">
          <div className="section-head">
            <h2>카테고리별 추천</h2>
            <button type="button" onClick={() => navigate('regions')}>지역별 보기</button>
          </div>
          <div className="category-shortcuts">
            {coreCategories.map((category) => (
              <button key={category} type="button" onClick={() => openCategory(category)}>
                <span>{category}</span>
                <b>{mockEvents.filter((event) => event.category === category).length}</b>
                <small>추천 공연 보기</small>
              </button>
            ))}
          </div>
        </section>

        <section className="content-section">
          <div className="section-head">
            <h2>지금 인기 있는 공연</h2>
            <button type="button" onClick={() => navigate('ranking')}>전체보기</button>
          </div>
          {renderEventGrid(rankedEvents.slice(0, 5))}
        </section>

        <section className="two-column-section">
          <div className="ranking-card">
            <h2>실시간 랭킹</h2>
            <ol>
              {rankedEvents.slice(0, 5).map((event, index) => (
                <li key={event.id}>
                  <span>{index + 1}</span>
                  <button className="rank-thumb" type="button" onClick={() => openEventDetail(event)} aria-label={`${event.title} 상세 보기`} />
                  <button type="button" onClick={() => openEventDetail(event)}>
                    {event.title}
                    <small>{event.captchaRequired ? 'AI CAPTCHA 적용' : '일반 예매'}</small>
                  </button>
                </li>
              ))}
            </ol>
          </div>
          <div className="quick-date-card">
            <h2>날짜별 빠른 예매</h2>
            <div className="date-tabs">
              {quickDates.map((date, index) => (
                <button
                  key={date.id}
                  className={index === 0 ? 'active' : ''}
                  type="button"
                  onClick={() => openQuickDate(date)}
                >
                  {date.label}
                </button>
              ))}
            </div>
          </div>
        </section>

        <section className="benefits-strip">
          {promotions.slice(0, 4).map((benefit) => (
            <div key={benefit}>{benefit}</div>
          ))}
          <div>AI CAPTCHA 보안 적용 사이트</div>
        </section>
      </main>
    );
  };

  const renderBookingPanel = (event) => (
    <aside className="booking-panel" aria-label="예매 패널">
      <div className="booking-preview">
        <div className={`mini-poster ${event.posterTone}`}>{event.category}<br />예매</div>
        <div>
          <b>{event.title}</b>
          <span>{event.dateRange}</span>
          <span>{event.venue}</span>
          {renderSecurityBadges(event, true)}
        </div>
      </div>

      <div className={`booking-security-strip ${event.captchaRequired ? 'protected' : 'standard'}`}>
        <b>{event.captchaRequired ? '이 예매 단계는 AI CAPTCHA 정책으로 보호됩니다.' : '빠른 일반 예매가 가능합니다.'}</b>
        <span>{demoRiskMode === 'bot' ? '봇 의심 사용자 mock 모드로 추가 인증이 적용됩니다.' : event.riskReason}</span>
      </div>

      {renderDemoRiskToggle()}

      <div className="option-block">
        <h3>관람일 선택</h3>
        <div className="choice-grid">
          {event.availableDates.map((date) => (
            <button
              key={date.id}
              type="button"
              className={selectedDateId === date.id ? 'active' : ''}
              onClick={() => setSelectedDateId(date.id)}
            >
              {date.label}
            </button>
          ))}
        </div>
      </div>

      <div className="option-block">
        <h3>회차 선택</h3>
        <div className="choice-grid two">
          {event.availableTimes.map((time) => (
            <button
              key={time}
              type="button"
              className={selectedTime === time ? 'active' : ''}
              onClick={() => setSelectedTime(time)}
            >
              {time}
            </button>
          ))}
        </div>
      </div>

      <div className="option-block">
        <h3>좌석 선택</h3>
        <div className="seat-list">
          {event.seatOptions.map((seat) => (
            <div className="seat-row" key={seat.id}>
              <div>
                <b>{seat.name}</b>
                <span>{formatWon(seat.price)}</span>
              </div>
              <div className="stepper">
                <button type="button" onClick={() => updateQuantity(seat.id, -1)} aria-label={`${seat.name} 수량 감소`}>−</button>
                <span>{safeQuantities[seat.id] || 0}</span>
                <button type="button" onClick={() => updateQuantity(seat.id, 1)} aria-label={`${seat.name} 수량 증가`}>+</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div className="booking-total">
        <span>총 {totalQuantity}매</span>
        <strong>{formatWon(totalPrice)}</strong>
      </div>

      <button className="primary-btn full" type="button" onClick={() => handleReserveClick(event)}>예매하기</button>
      <button className="secondary-btn full" type="button" onClick={() => addEventToCart(event)}>장바구니 담기</button>
      <button className="ghost-btn full" type="button" onClick={() => toggleLike(event.title)}>
        {likedShows.includes(event.title) ? '찜 해제' : '찜하기'}
      </button>
    </aside>
  );

  const renderEventDetail = () => {
    const event = activeEvent;

    return (
      <main className="page-shell">
        <section className="event-detail-layout">
          <div className="event-detail-main">
            <div className={`event-visual ${event.posterTone}`}>
              <span>{event.badge}</span>
              <b>{event.title}</b>
            </div>
            <div className="event-detail-copy">
              <span className="page-kicker">{event.category}</span>
              <h1>{event.title}</h1>
              {renderSecurityBadges(event)}
              <p>{event.subtitle}</p>
              <div className="event-meta-grid">
                <div><b>공연기간</b><span>{event.dateRange}</span></div>
                <div><b>장소</b><span>{event.venue}</span></div>
                <div><b>지역</b><span>{event.region}</span></div>
                <div><b>관심</b><span>{event.likes.toLocaleString('ko-KR')}</span></div>
              </div>
              <article className="detail-description">
                <h2>공연 소개</h2>
                <p>{event.detailDescription}</p>
              </article>
              {renderSecurityPolicyCard(event)}
            </div>
          </div>
          {renderBookingPanel(event)}
        </section>
      </main>
    );
  };

  const renderListingPage = ({ kicker, title, subtitle, events, emptyText }) => (
    <main className="page-shell listing-page">
      <section className="dashboard-head">
        <div>
          <span className="page-kicker">{kicker}</span>
          <h1>{title}</h1>
          {subtitle && <p>{subtitle}</p>}
        </div>
      </section>
      {renderEventGrid(events, emptyText)}
    </main>
  );

  const renderSearch = () => (
    <main className="page-shell listing-page">
      <section className="dashboard-head">
        <div>
          <span className="page-kicker">SEARCH</span>
          <h1>검색 결과</h1>
          <p>검색어: {submittedSearch || '전체'} · {searchResults.length}개</p>
        </div>
      </section>
      {renderEventGrid(searchResults, '검색 결과가 없습니다.')}
    </main>
  );

  const renderRanking = () => (
    <main className="page-shell listing-page">
      <section className="dashboard-head">
        <div>
          <span className="page-kicker">RANKING</span>
          <h1>실시간 랭킹</h1>
          <p>예매 관심도와 판매 흐름을 반영한 mock 랭킹입니다.</p>
        </div>
      </section>
      <div className="ranking-list-page">
        {rankedEvents.map((event, index) => (
          <button key={event.id} type="button" onClick={() => openEventDetail(event)}>
            <span>{index + 1}</span>
            <div className={`rank-poster ${event.posterTone}`} />
            <div>
              <b>{event.title}</b>
              <small>{event.category} · {event.venue}</small>
              <em>{event.captchaRequired ? 'AI CAPTCHA 적용' : '일반 예매'}</em>
            </div>
            <strong>{event.likes.toLocaleString('ko-KR')}</strong>
          </button>
        ))}
      </div>
    </main>
  );

  const renderBenefits = () => (
    <main className="page-shell listing-page">
      <section className="dashboard-head">
        <div>
          <span className="page-kicker">EVENTS & BENEFITS</span>
          <h1>이벤트·혜택</h1>
          <p>티켓온에서 준비한 데모 프로모션입니다.</p>
        </div>
      </section>
      <div className="promotion-grid">
        {promotions.map((promotion, index) => (
          <article key={promotion}>
            <span>BENEFIT {index + 1}</span>
            <h2>{promotion}</h2>
            <p>실제 쿠폰이나 결제 할인은 연결되지 않은 frontend-only mock 혜택입니다.</p>
          </article>
        ))}
      </div>
    </main>
  );

  const renderRegions = () => (
    <main className="page-shell listing-page">
      <section className="dashboard-head">
        <div>
          <span className="page-kicker">REGION</span>
          <h1>지역별 공연</h1>
          <p>{selectedRegion} 지역 기준으로 공연을 모아봅니다.</p>
        </div>
      </section>
      <div className="region-tabs">
        {regionOptions.map((region) => (
          <button
            key={region}
            className={selectedRegion === region ? 'active' : ''}
            type="button"
            onClick={() => setSelectedRegion(region)}
          >
            {region}
          </button>
        ))}
      </div>
      {renderEventGrid(regionEvents, '선택한 지역의 공연이 없습니다.')}
    </main>
  );

  const renderDatePage = () => (
    <main className="page-shell listing-page">
      <section className="dashboard-head">
        <div>
          <span className="page-kicker">QUICK DATE</span>
          <h1>날짜별 빠른 예매</h1>
          <p>{selectedQuickDate.label} 예매 가능 공연입니다.</p>
        </div>
      </section>
      <div className="date-tabs page-tabs">
        {quickDates.map((date) => (
          <button
            key={date.id}
            className={selectedQuickDate.id === date.id ? 'active' : ''}
            type="button"
            onClick={() => setSelectedQuickDate(date)}
          >
            {date.label}
          </button>
        ))}
      </div>
      {renderEventGrid(quickDateEvents, '선택한 날짜의 예매 가능 공연이 없습니다.')}
    </main>
  );

  const renderLogin = () => (
    <main className="auth-page">
      <section className="auth-card">
        <span className="page-kicker">TICKETON LOGIN</span>
        <h1>로그인</h1>
        <p>데모 계정 또는 직접 가입한 계정으로 로그인할 수 있습니다.</p>
        {loginNotice && <div className="success-message">{loginNotice}</div>}
        <form onSubmit={handleLogin}>
          <label>
            <span>아이디</span>
            <input value={loginForm.id} onChange={(event) => setLoginForm({ ...loginForm, id: event.target.value })} />
          </label>
          <label>
            <span>비밀번호</span>
            <input type="password" value={loginForm.password} onChange={(event) => setLoginForm({ ...loginForm, password: event.target.value })} />
          </label>
          <label className="checkbox-row">
            <input
              type="checkbox"
              checked={loginForm.autoLogin}
              onChange={(event) => setLoginForm({ ...loginForm, autoLogin: event.target.checked })}
            />
            <span>자동 로그인</span>
          </label>
          {loginError && <div className="error-message">{loginError}</div>}
          <button className="primary-btn full" type="submit">로그인</button>
          <button className="secondary-btn full" type="button" onClick={() => navigate('signup')}>회원가입으로 이동</button>
        </form>
        <div className="demo-account">
          <b>기본 데모 계정</b>
          <span>ID: demo / Password: demo1234</span>
        </div>
      </section>
    </main>
  );

  const renderSignup = () => (
    <main className="auth-page">
      <section className="auth-card">
        <span className="page-kicker">CREATE ACCOUNT</span>
        <h1>회원가입</h1>
        <p>티켓온 데모 사이트에서 사용할 로컬 mock 계정을 만듭니다.</p>
        <form onSubmit={handleSignup}>
          <label>
            <span>이름</span>
            <input value={signupForm.name} onChange={(event) => setSignupForm({ ...signupForm, name: event.target.value })} />
          </label>
          <label>
            <span>아이디</span>
            <input value={signupForm.id} onChange={(event) => setSignupForm({ ...signupForm, id: event.target.value })} />
          </label>
          <label>
            <span>이메일</span>
            <input type="email" value={signupForm.email} onChange={(event) => setSignupForm({ ...signupForm, email: event.target.value })} />
          </label>
          <label>
            <span>비밀번호</span>
            <input type="password" value={signupForm.password} onChange={(event) => setSignupForm({ ...signupForm, password: event.target.value })} />
          </label>
          <label>
            <span>비밀번호 확인</span>
            <input type="password" value={signupForm.confirmPassword} onChange={(event) => setSignupForm({ ...signupForm, confirmPassword: event.target.value })} />
          </label>
          <label>
            <span>휴대폰 번호</span>
            <input value={signupForm.phone} placeholder="010-0000-0000" onChange={(event) => setSignupForm({ ...signupForm, phone: event.target.value })} />
          </label>
          <label className="checkbox-row">
            <input
              type="checkbox"
              checked={signupForm.terms}
              onChange={(event) => setSignupForm({ ...signupForm, terms: event.target.checked })}
            />
            <span>약관 동의</span>
          </label>
          {signupError && <div className="error-message">{signupError}</div>}
          {signupMessage && <div className="success-message">{signupMessage}</div>}
          <button className="primary-btn full" type="submit">회원가입</button>
          <button className="secondary-btn full" type="button" onClick={() => navigate('login')}>로그인으로 이동</button>
        </form>
      </section>
    </main>
  );

  const renderReservationCard = (reservation) => (
    <article className="reservation-card" key={reservation.id}>
      <div>
        <span>예매번호 {reservation.id}</span>
        <h3>{reservation.title}</h3>
        <p>{reservation.date} · {reservation.time} · {reservation.venue}</p>
        <p>{reservation.seatSummary}</p>
      </div>
      <dl>
        <div><dt>총 결제 예정 금액</dt><dd>{formatWon(reservation.totalPrice)}</dd></div>
        <div><dt>상태</dt><dd>{reservation.status}</dd></div>
        <div><dt>보안 상태</dt><dd>{getSecurityDecisionLabel(reservation)}</dd></div>
      </dl>
    </article>
  );

  const renderMyPage = () => {
    if (!currentUser) {
      return (
        <main className="page-shell">
          <section className="empty-state">
            <h1>마이페이지는 로그인 후 이용할 수 있습니다.</h1>
            <button className="primary-btn" type="button" onClick={() => navigate('login')}>로그인하기</button>
          </section>
        </main>
      );
    }

    return (
      <main className="page-shell">
        <section className="dashboard-head">
          <div>
            <span className="page-kicker">MY TICKETON</span>
            <h1>{currentUser.name}님의 마이페이지</h1>
          </div>
        </section>
        <section className="mypage-grid">
          <article className="profile-card">
            <h2>회원 정보 카드</h2>
            <dl>
              <div><dt>이름</dt><dd>{currentUser.name}</dd></div>
              <div><dt>아이디</dt><dd>{currentUser.id}</dd></div>
              <div><dt>이메일</dt><dd>{currentUser.email}</dd></div>
              <div><dt>휴대폰 번호</dt><dd>{currentUser.phone}</dd></div>
            </dl>
          </article>
          <article className="stats-card"><span>보유 포인트</span><strong>2,000P</strong></article>
          <article className="stats-card"><span>관심 공연 수</span><strong>{likedShows.length}</strong></article>
          <article className="stats-card"><span>예매 내역 수</span><strong>{validReservations.length}</strong></article>
        </section>
        <section className="dashboard-grid">
          <article className="panel-card">
            <h2>최근 예매 내역</h2>
            {validReservations.length ? validReservations.slice(0, 3).map(renderReservationCard) : <p className="muted">최근 예매 내역이 없습니다.</p>}
          </article>
          <article className="panel-card">
            <h2>찜한 공연</h2>
            {likedShows.length ? likedShows.map((show) => <p key={show} className="simple-row">{show}</p>) : <p className="muted">찜한 공연이 없습니다.</p>}
          </article>
          <article className="panel-card wide">
            <h2>나의 혜택</h2>
            <div className="benefit-list">
              <span>신규 회원 2,000P 적립</span>
              <span>선예매 알림 신청 가능</span>
              <span>공연별 할인 쿠폰 준비 중</span>
            </div>
          </article>
        </section>
      </main>
    );
  };

  const renderReservations = () => (
    <main className="page-shell">
      <section className="dashboard-head">
        <div>
          <span className="page-kicker">RESERVATIONS</span>
          <h1>예매확인</h1>
        </div>
      </section>
      {validReservations.length ? (
        <div className="reservation-list">{validReservations.map(renderReservationCard)}</div>
      ) : (
        <section className="empty-state">
          <h1>아직 예매 내역이 없습니다.</h1>
          <button className="primary-btn" type="button" onClick={() => navigate('home')}>공연 보러가기</button>
        </section>
      )}
    </main>
  );

  const renderCart = () => (
    <main className="page-shell">
      <section className="dashboard-head">
        <div>
          <span className="page-kicker">CART</span>
          <h1>장바구니</h1>
        </div>
      </section>
      {validCartItems.length ? (
        <section className="cart-layout">
          <div className="cart-list">
            {validCartItems.map((item) => (
              <article className="cart-item" key={item.id}>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.dateLabel} · {item.time} · {item.venue}</p>
                  <p>{item.seatSummary} · 총 {item.quantity}매</p>
                </div>
                <strong>{formatWon(item.totalPrice)}</strong>
                <button type="button" onClick={() => removeCartItem(item.id)}>삭제</button>
              </article>
            ))}
          </div>
          <aside className="cart-summary">
            <span>총 금액</span>
            <strong>{formatWon(cartTotalPrice)}</strong>
            <div className="cart-security-note">
              {getBookingSecurityProfile({ source: 'cart', items: validCartItems }, demoRiskMode).captchaRequired
                ? '장바구니에 AI CAPTCHA 보호 대상 공연이 포함되어 있습니다.'
                : '현재 장바구니는 일반 예매로 진행할 수 있습니다.'}
            </div>
            {renderDemoRiskToggle()}
            <button className="primary-btn full" type="button" onClick={proceedCartBooking}>예매 진행</button>
          </aside>
        </section>
      ) : (
        <section className="empty-state">
          <h1>장바구니가 비어 있습니다.</h1>
          <button className="primary-btn" type="button" onClick={() => navigate('home')}>공연 보러가기</button>
        </section>
      )}
    </main>
  );

  const renderPage = () => {
    if (page === 'login') return renderLogin();
    if (page === 'signup') return renderSignup();
    if (page === 'mypage') return renderMyPage();
    if (page === 'reservations') return renderReservations();
    if (page === 'cart') return renderCart();
    if (page === 'eventDetail') return renderEventDetail();
    if (page === 'search') return renderSearch();
    if (page === 'category') {
      return renderListingPage({
        kicker: 'CATEGORY',
        title: activeCategory || '카테고리',
        subtitle: `티켓온에서 추천하는 ${activeCategory || '공연'}입니다.`,
        events: categoryEvents,
        emptyText: '선택한 카테고리의 공연이 없습니다.'
      });
    }
    if (page === 'ranking') return renderRanking();
    if (page === 'benefits') return renderBenefits();
    if (page === 'regions') return renderRegions();
    if (page === 'date') return renderDatePage();
    return renderHome();
  };

  return (
    <>
      {renderHeader()}
      {renderDrawer()}
      {renderPage()}
      {toast && <div className="toast" role="status">{toast}</div>}
      {queueOpen && (
        <QueueModal
          booking={pendingBooking}
          demoRiskMode={demoRiskMode}
          onCancel={cancelQueue}
          onEnter={enterQueue}
        />
      )}
      {captchaOpen && (
        <CaptchaModal
          booking={pendingBooking}
          demoRiskMode={demoRiskMode}
          onCancel={() => {
            setCaptchaOpen(false);
            setPendingBooking(null);
          }}
          onComplete={completeCaptcha}
        />
      )}
      {successReservation && (
        <SuccessModal
          reservation={successReservation}
          onClose={() => setSuccessReservation(null)}
          onMove={() => {
            setSuccessReservation(null);
            navigate('reservations');
          }}
        />
      )}
    </>
  );
}

function QueueModal({ booking, demoRiskMode, onCancel, onEnter }) {
  const safeBooking = sanitizeBooking(booking);
  const profile = getBookingSecurityProfile(safeBooking, demoRiskMode, true, false);
  const firstItem = safeBooking?.items[0];
  const queueNumber = 1284 + safeString(firstItem?.eventId).length * 17;

  return (
    <div className="modal-backdrop" role="presentation" onMouseDown={onCancel}>
      <section
        className="modal-card queue-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="queue-title"
        onMouseDown={(event) => event.stopPropagation()}
      >
        <button className="modal-close" type="button" onClick={onCancel} aria-label="닫기">×</button>
        <span className="page-kicker">TRAFFIC QUEUE</span>
        <h2 id="queue-title">예매 대기열 입장</h2>
        <p>현재 접속자가 많아 예매 대기열이 적용되었습니다.</p>
        <p>자동화 봇 유입을 줄이기 위해 입장 전 보안 확인이 진행됩니다.</p>

        <div className="queue-status-card">
          <div>
            <span>대상 공연</span>
            <strong>{firstItem?.title || '선택한 공연'}</strong>
          </div>
          <div>
            <span>대기번호</span>
            <strong>{queueNumber.toLocaleString('ko-KR')}번</strong>
          </div>
          <div>
            <span>예상 대기시간</span>
            <strong>약 1분</strong>
          </div>
        </div>

        <div className="queue-progress" aria-hidden="true"><span /></div>
        <div className="event-security-badges">
          <span className={`security-pill traffic-${profile.trafficLevel}`}>{profile.trafficLevel}</span>
          <span className={`security-pill ${profile.captchaRequired ? 'captcha' : 'normal'}`}>
            {profile.captchaRequired ? 'AI CAPTCHA 적용' : '일반 예매'}
          </span>
        </div>

        <div className="modal-actions">
          <button className="secondary-btn" type="button" onClick={onCancel}>취소</button>
          <button className="primary-btn" type="button" onClick={onEnter}>대기열 입장하기</button>
        </div>
      </section>
    </div>
  );
}

function CaptchaModal({ booking, demoRiskMode, onCancel, onComplete }) {
  const safeBooking = sanitizeBooking(booking);
  const profile = getBookingSecurityProfile(safeBooking, demoRiskMode, safeBooking?.queueUsed, false);
  const total = safeBooking?.items.reduce((sum, item) => sum + item.totalPrice, 0) || 0;

  return (
    <div className="modal-backdrop" role="presentation" onMouseDown={onCancel}>
      <section
        className="modal-card captcha-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="captcha-title"
        onMouseDown={(event) => event.stopPropagation()}
      >
        <button className="modal-close" type="button" onClick={onCancel} aria-label="닫기">×</button>
        <span className="page-kicker">AI CAPTCHA</span>
        <h2 id="captcha-title">AI CAPTCHA 인증</h2>
        <p>자동 예매 봇 방지를 위해 인증을 완료해 주세요.</p>
        <div className={`captcha-policy-box ${profile.demoRiskMode === 'bot' ? 'warning' : 'protected'}`}>
          <b>{profile.demoRiskMode === 'bot' ? '봇 의심 패턴 감지' : '이 예매 건은 AI CAPTCHA 보호 대상입니다.'}</b>
          <span>{profile.riskReason}</span>
        </div>

        <div className="captcha-grid">
          <article className="captcha-type-card">
            <b>유형 1 드래그형</b>
            <span>아스키 아트 이미지를 목표 영역으로 드래그</span>
            <div className="drag-captcha-demo">
              <pre>{`/\\_/\\
( o.o )
> ^ <`}</pre>
              <div>목표 영역</div>
            </div>
          </article>
          <article className="captcha-type-card">
            <b>유형 2 식별형</b>
            <span>아스키 아트 문제 이미지를 보고 정답 선택</span>
            <div className="answer-cards">
              <button type="button">고양이</button>
              <button type="button">강아지</button>
              <button type="button">자동차</button>
            </div>
          </article>
        </div>

        <p className="captcha-mock-note">
          실제 서비스에서는 CAPTCHA 검증 API와 연결됩니다. 현재는 시연용 mock입니다.
        </p>

        <div className="modal-summary-line">
          <span>예상 결제 금액</span>
          <strong>{formatWon(total)}</strong>
        </div>
        <div className="modal-actions">
          <button className="secondary-btn" type="button" onClick={onCancel}>취소</button>
          <button className="primary-btn" type="button" onClick={onComplete}>인증 완료</button>
        </div>
      </section>
    </div>
  );
}

function SuccessModal({ reservation, onClose, onMove }) {
  const safeReservation = sanitizeReservation(reservation);

  if (!safeReservation) {
    return (
      <div className="modal-backdrop" role="presentation" onMouseDown={onClose}>
        <section
          className="modal-card success-modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="success-title"
          onMouseDown={(event) => event.stopPropagation()}
        >
          <button className="modal-close" type="button" onClick={onClose} aria-label="닫기">×</button>
          <h2 id="success-title">예매 정보를 표시할 수 없습니다.</h2>
          <p>예매 정보를 다시 선택해 주세요.</p>
          <div className="modal-actions">
            <button className="primary-btn" type="button" onClick={onClose}>확인</button>
          </div>
        </section>
      </div>
    );
  }

  return (
    <div className="modal-backdrop" role="presentation" onMouseDown={onClose}>
      <section
        className="modal-card success-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="success-title"
        onMouseDown={(event) => event.stopPropagation()}
      >
        <button className="modal-close" type="button" onClick={onClose} aria-label="닫기">×</button>
        <div className="success-icon">✓</div>
        <h2 id="success-title">예매 신청 완료</h2>
        <p>
          {safeReservation.captchaRequired
            ? 'AI CAPTCHA 인증이 완료되어 예매 신청이 접수되었습니다.'
            : '일반 예매로 예매 신청이 접수되었습니다.'}
        </p>
        <dl className="success-summary">
          <div><dt>예매번호</dt><dd>{safeReservation.id}</dd></div>
          <div><dt>공연명</dt><dd>{safeReservation.title}</dd></div>
          <div><dt>날짜</dt><dd>{safeReservation.date}</dd></div>
          <div><dt>회차</dt><dd>{safeReservation.time}</dd></div>
          <div><dt>선택 좌석 수량</dt><dd>{safeReservation.quantity}매</dd></div>
          <div><dt>총 결제 예정 금액</dt><dd>{formatWon(safeReservation.totalPrice)}</dd></div>
        </dl>
        <section className="security-report-card">
          <h3>보안 인증 결과</h3>
          <dl>
            <div>
              <dt>적용 정책</dt>
              <dd>{safeReservation.captchaRequired ? 'AI CAPTCHA 적용' : '일반 예매'}</dd>
            </div>
            <div>
              <dt>인증 상태</dt>
              <dd>{safeReservation.captchaRequired ? '완료' : 'CAPTCHA 미적용'}</dd>
            </div>
            <div>
              <dt>위험도</dt>
              <dd>{getRiskLabel(safeReservation.riskLevel)}</dd>
            </div>
            <div>
              <dt>대기열</dt>
              <dd>{safeReservation.queueUsed ? '사용' : '미사용'}</dd>
            </div>
            <div>
              <dt>조치</dt>
              <dd>{safeReservation.securityDecision}</dd>
            </div>
            {safeReservation.demoRiskMode === 'bot' && (
              <div>
                <dt>데모 시나리오</dt>
                <dd>봇 의심 사용자</dd>
              </div>
            )}
            <div>
              <dt>사유</dt>
              <dd>{safeReservation.captchaSkippedReason || safeReservation.riskReason}</dd>
            </div>
          </dl>
        </section>
        <div className="modal-actions">
          <button className="secondary-btn" type="button" onClick={onMove}>예매확인으로 이동</button>
          <button className="primary-btn" type="button" onClick={onClose}>확인</button>
        </div>
      </section>
    </div>
  );
}
